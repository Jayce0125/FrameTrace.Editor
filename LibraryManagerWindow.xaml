<UserControl x:Class="FrameTrace.Editor.LibraryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FrameTrace.Editor"
        MinWidth="0" MinHeight="0">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryTextBlock" VerticalAlignment="Center" Foreground="#555555" Text="正在读取已入库素材..." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Padding="12,5" Click="Reload_Click">刷新列表</Button>
                <Button x:Name="SortCurrentCategoryAssetsButton" Margin="8,0,0,0" Padding="12,5" Click="SortCurrentCategoryAssets_Click" IsEnabled="False">按名称重排当前分类</Button>
                <Button Margin="8,0,0,0" Padding="12,5" Click="RepairAndPublish_Click">修复并发布索引</Button>
                <Button Margin="8,0,0,0" Padding="12,5" Click="DeleteSelected_Click">删除选中</Button>
                <Button Margin="8,0,0,0" Padding="12,5" Click="ClearLibrary_Click">清空素材库</Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="CategoryTreeView" AllowDrop="True"
                      SelectedItemChanged="CategoryTreeView_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="CategoryTreeView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="CategoryTreeView_PreviewMouseMove"
                      PreviewDragOver="CategoryTreeView_DragOver"
                      PreviewDragLeave="CategoryTreeView_DragLeave"
                      PreviewDrop="CategoryTreeView_Drop">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:CategoryTreeItem}" ItemsSource="{Binding Children}">
                        <Border Padding="2" BorderThickness="0,0,0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2D7DCC" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Name}" />
                        </Border>
                    </HierarchicalDataTemplate>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                    </Style>
                </TreeView.Resources>
            </TreeView>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#D0D0D0" Cursor="SizeWE" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          ToolTip="拖动以调整分类树和素材列表的宽度" />
            <ListView x:Name="AssetListView" Grid.Column="2" AllowDrop="True"
                      SelectionMode="Extended" SelectionChanged="AssetListView_SelectionChanged"
                      PreviewMouseLeftButtonDown="AssetListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="AssetListView_PreviewMouseMove"
                      PreviewDragOver="AssetListView_DragOver"
                      PreviewDrop="AssetListView_Drop">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="5" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="ItemBorder" Grid.Row="0"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                  Columns="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListView}}, Path=View.Columns}" />
                                        </Border>
                                        <Rectangle Grid.Row="1"
                                                   Height="5"
                                                   HorizontalAlignment="Stretch"
                                                   Fill="#FF0084FF"
                                                   Visibility="{Binding Content.IsDropTarget, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#DCEBFF" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7AADE8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="240" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Header="分类" Width="180" DisplayMemberBinding="{Binding FolderName}" />
                        <GridViewColumn Header="主视频" Width="240" DisplayMemberBinding="{Binding VideoName}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Border Grid.Column="4" Padding="12" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="编辑素材信息" FontSize="16" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <TextBlock x:Name="EditorEmptyStateTextBlock" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="#777777" TextWrapping="Wrap"
                                   Text="选择一条素材以编辑其名称、提示词和生成元数据。" />
                        <ScrollViewer x:Name="EditorScrollViewer" VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <StackPanel x:Name="EditorFormPanel">
                                <TextBlock Margin="0,0,0,4" Text="名称" />
                                <TextBox x:Name="DisplayNameTextBox" Margin="0,0,0,10" Padding="6,4"
                                         TextChanged="EditorField_Changed" />

                                <TextBlock Margin="0,0,0,4" Text="提示词" />
                                <TextBox x:Name="PromptTextBox" Margin="0,0,0,14" Padding="6,4"
                                         MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" TextChanged="EditorField_Changed" />

                                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="生成元数据" />
                                <TextBlock Margin="0,0,0,4" Text="创建时间" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="CreatedDatePicker" SelectedDateChanged="EditorField_Changed" />
                                    <TextBox x:Name="CreatedTimeTextBox" Grid.Column="1" Margin="6,0,0,0"
                                             Padding="6,4" ToolTip="时间格式：HH:mm"
                                             TextChanged="EditorField_Changed" />
                                </Grid>

                                <TextBlock Margin="0,0,0,4" Text="清晰度" />
                                <ComboBox x:Name="QualityComboBox" Margin="0,0,0,10" Padding="6,4"
                                          SelectionChanged="EditorField_Changed" />

                                <TextBlock Margin="0,0,0,4" Text="宽高比" />
                                <ComboBox x:Name="AspectRatioComboBox" Margin="0,0,0,10" Padding="6,4"
                                          SelectionChanged="EditorField_Changed" />

                                <TextBlock Margin="0,0,0,4" Text="生成模型或功能" />
                                <TextBox x:Name="FeatureTextBox" Margin="0,0,0,10" Padding="6,4"
                                         TextChanged="EditorField_Changed" />

                                <TextBlock Margin="0,0,0,4" Text="使用的 skill" />
                                <TextBox x:Name="SkillsTextBox" Padding="6,4" MinHeight="64"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" TextChanged="EditorField_Changed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="EditorStatusTextBlock" Margin="0,0,0,8" Foreground="#666666"
                                   Text="尚未选择素材。" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelEditButton" Padding="12,5" IsEnabled="False"
                                    Click="CancelEdit_Click">取消</Button>
                            <Button x:Name="SaveEditButton" Margin="8,0,0,0" Padding="12,5"
                                    IsEnabled="False" Click="SaveEdit_Click">保存修改</Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>